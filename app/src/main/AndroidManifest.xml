<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- LLM calls, YouTube metadata / thumbnails / transcripts, video downloads -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Tail habit integration (signature-level permission — Wags/Octo pattern) -->
    <uses-permission android:name="com.example.tail.permission.TAIL_INTEGRATION" />

    <!-- Package visibility (API 30+): the Tail app and its habit content provider -->
    <queries>
        <package android:name="com.example.tail" />
        <provider android:authorities="com.example.tail.provider" />
    </queries>

    <application
        android:name=".KengaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:resizeableActivity="false"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kenga">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Kenga"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ACTION_SEND trampoline: YouTube app "Share" → Kenga library
             (Octo pattern — translucent, noHistory, out of recents). -->
        <activity
            android:name=".youtube.ShareIngestActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/share_activity_label"
            android:noHistory="true"
            android:screenOrientation="portrait"
            android:taskAffinity=""
            android:theme="@style/Theme.Kenga.Translucent">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Home-screen widget: the kangaroo-man rendered off the dashboard
             drawing pipeline; tap opens the app (see widget/KengaWidgetProvider.kt). -->
        <receiver
            android:name=".widget.KengaWidgetProvider"
            android:exported="false"
            android:label="@string/kenga_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/kenga_widget_info" />
        </receiver>

        <!-- On-demand WorkManager init (KengaApplication implements
             Configuration.Provider — remove the default initializer). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!--
            Live kangaroo-man figure for Tail's combined scene widget.
            Read-only; signature-gated by Tail's TAIL_INTEGRATION
            permission (Tail is already signed with our keystore).
            Protocol: content://com.example.kenga.figure/v1/figure with
            columns figure (PNG blob) / hash / updated — Tail hash-gates
            its pulls so repeat refreshes cost one cheap query.
        -->
        <provider
            android:name=".widget.FigureSnapshotProvider"
            android:authorities="com.example.kenga.figure"
            android:exported="true"
            android:readPermission="com.example.tail.permission.TAIL_INTEGRATION" />
    </application>

</manifest>
